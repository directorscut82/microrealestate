<tr>
  <th><%= _.t('Description') %></th>
  <th><%= _.t('Quantity') %></th>
  <th><%= _.t('Unit price without VAT') %></th>
  <th><%= _.t('Total without VAT') %></th>
</tr>

<%
// Building expense type → localized label key. MUST match the landlord app's
// single map (webapps/landlord/src/utils/lineLabels.js) and the expense table,
// so the SAME type reads identically on the receipt PDF and every on-screen
// surface (Water Common / Electricity Common / Management Fee — the full labels,
// not the abbreviated Water/Electricity/Management that diverged before).
var BUILDING_TYPE_LABEL_KEY = {
  heating: 'Heating',
  elevator: 'Elevator',
  cleaning: 'Cleaning',
  water_common: 'Water Common',
  electricity_common: 'Electricity Common',
  insurance: 'Insurance',
  management_fee: 'Management Fee',
  garden: 'Garden',
  repairs_fund: 'Repairs Fund',
  pest_control: 'Pest Control',
  monthly_charge: 'Other',
  other: 'Other',
  repair: 'Repair'
};
function rentLabel(item) {
  var d = (item && item.description ? String(item.description).trim() : '');
  return d ? (_.t('Rent') + '  (' + d + ')') : _.t('Rent');
}
function buildingLabel(charge) {
  var typeKey = BUILDING_TYPE_LABEL_KEY[charge.type] || 'Other';
  var typeLabel = _.t(typeKey);
  var d = (charge && charge.description ? String(charge.description).trim() : '');
  var b = (charge && charge.buildingName ? String(charge.buildingName).trim() : '');
  var paren;
  if (b && d) paren = '(' + b + ' - ' + d + ')';
  else if (b) paren = '(' + b + ')';
  else if (d) paren = '(' + d + ')';
  else paren = '';
  return paren ? (typeLabel + '  ' + paren) : typeLabel;
}
function debtLabel(debt) {
  var d = (debt && debt.description ? String(debt.description).trim() : '');
  return d || _.t('Additional cost');
}
// Item 6: render a charge's calc-basis equation (the SAME wording as the
// on-screen ΧΡΕΩΣΕΙΣ panel's formatBasis). euros use the currency formatter
// with the € symbol stripped (the i18n strings carry a literal ' €'); m²/‰ and
// counts stay raw. Returns '' when no basis applies (→ no sub-line rendered).
function formatBasis(basis) {
  if (!basis || typeof basis !== 'object') return '';
  // Internal-consistency backstop (Step-7 / PDF-render finding): NEVER print an
  // equation whose LHS does not evaluate to its stated RHS. A co-owned charge
  // arrives sliced (€25 of a €50 owner pool); the basis must show the full pool
  // (€50) with a co-owner suffix bridging to €25. If the numbers don't
  // reconcile (legacy/edge data), render NO sub-line rather than a false one.
  var EPS = 0.02;
  var ok = false, lhs;
  switch (basis.kind) {
    case 'equal': ok = Number(basis.count) > 0; if (ok) lhs = (Number(basis.total)||0)/Number(basis.count); break;
    case 'surface':
    case 'thousandths':
    case 'custom_ratio': ok = Number(basis.whole) > 0; if (ok) lhs = ((Number(basis.part)||0)/Number(basis.whole))*(Number(basis.total)||0); break;
    case 'custom_percentage': ok = true; lhs = ((Number(basis.part)||0)/100)*(Number(basis.total)||0); break;
    case 'repair_split': ok = true; lhs = (Number(basis.total)||0)*((Number(basis.ownerPct)||0)/100); break;
    case 'repair_vacant': ok = true; lhs = (Number(basis.total)||0)*((Number(basis.tenantPct)||0)/100); break; // RHS = pool
    case 'fixed':
    case 'single_unit': ok = true; break; // no divisor to contradict
    default: return '';
  }
  if (!ok) return '';
  if (lhs !== undefined) {
    var rhs = (basis.kind === 'repair_vacant') ? (Number(basis.pool)||0)
            : (basis.kind === 'repair_split') ? (Number(basis.result)||0)
            : (Number(basis.share)||0);
    if (Math.abs(lhs - rhs) > EPS) return '';
  }
  var e = function (n) {
    return String(_.formatNumber(Number(n) || 0, 'currency')).replace(/\s*€\s*/g, '').trim();
  };
  var q = function (n) { return (Number(n) || 0).toString().replace('.', ','); };
  switch (basis.kind) {
    case 'equal':
      return _.t('{{total}} € ÷ {{count}} units = {{share}} €', { total: e(basis.total), count: basis.count, share: e(basis.share) });
    case 'surface':
      return _.t('unit surface {{part}} m² ÷ total {{whole}} m² × cost {{total}} € = {{share}} €', { part: q(basis.part), whole: q(basis.whole), total: e(basis.total), share: e(basis.share) });
    case 'thousandths':
      return _.t('unit thousandths {{part}} ÷ {{whole}} total × cost {{total}} € = {{share}} €', { part: q(basis.part), whole: q(basis.whole), total: e(basis.total), share: e(basis.share) });
    case 'fixed':
      return _.t('fixed amount per unit: {{share}} €', { share: e(basis.share) });
    case 'single_unit':
      return _.t('the whole amount is charged to one unit: {{share}} €', { share: e(basis.share) });
    case 'custom_ratio':
      return (basis.part != null && basis.whole != null)
        ? _.t('({{part}} ÷ {{whole}}) × cost {{total}} € = {{share}} €', { part: basis.part, whole: basis.whole, total: e(basis.total), share: e(basis.share) })
        : _.t('custom ratio share: {{share}} €', { share: e(basis.share) });
    case 'custom_percentage':
      return (basis.part != null)
        ? _.t('unit percentage {{part}}% × cost {{total}} € = {{share}} €', { part: basis.part, total: e(basis.total), share: e(basis.share) })
        : _.t('custom percentage share: {{share}} €', { share: e(basis.share) });
    case 'repair_split':
      return _.t('cost {{total}} € × owner share {{pct}}% = {{share}} €', { total: e(basis.total), pct: basis.ownerPct, share: e(basis.result) });
    case 'repair_vacant':
      return _.t('cost {{total}} € × tenants share {{pct}}% = {{pool}} €', { total: e(basis.total), pct: basis.tenantPct, pool: e(basis.pool) });
    default:
      return '';
  }
}
%>

<%# R2-L9: `|| []` guard — a legacy/direct-mongo rent row that bypassed
    BL.computeRent may lack these arrays; without the guard the PDF 500s/blanks
    (buildingCharges:56 + charges:94 already guard; mirror them here). %>
<% (rent.preTaxAmounts || []).forEach(function(preTaxAmount) { %>
  <tr class="item-row">
    <td class="description"><%= rentLabel(preTaxAmount) %></td>
    <td class="txtAlignRight">1</td>
    <td class="txtAlignRight"><%= _.formatNumber(preTaxAmount.amount, 'currency') %></td>
    <td class="txtAlignRight"><%= _.formatNumber(preTaxAmount.amount, 'currency') %></td>
  </tr>
<% }); %>

<% (rent.buildingCharges || []).forEach(function(charge) { %>
  <%
    // Per-owner split suffix for a co-owned charge: "(Name 50% = €50, λοιποί 50% = €50)".
    var coSuffix = '';
    if (Array.isArray(charge.coOwners) && charge.coOwners.length > 1) {
      coSuffix = '  (' + charge.coOwners.map(function(o){
        var nm = o.isRest ? _.t('others') : o.name;
        return nm + ' ' + o.percentage + '% = ' + _.formatNumber(o.amount, 'currency');
      }).join(', ') + ')';
    }
  %>
  <% var basisText = formatBasis(charge.basis); %>
  <tr class="item-row">
    <td class="description">
      <%= buildingLabel(charge) %><%= coSuffix %>
      <% if (basisText) { %><div class="calc-basis"><%= basisText %></div><% } %>
    </td>
    <td class="txtAlignRight">1</td>
    <td class="txtAlignRight"><%= _.formatNumber(charge.amount, 'currency') %></td>
    <td class="txtAlignRight"><%= _.formatNumber(charge.amount, 'currency') %></td>
  </tr>
<% }); %>

<% (rent.discounts || []).forEach(function(discount) { %>
  <tr class="item-row">
    <td class="description"><%= discount.description %></td>
    <td class="txtAlignRight">1</td>
    <td class="txtAlignRight">- <%= _.formatNumber(discount.amount, 'currency') %></td>
    <td class="txtAlignRight">- <%= _.formatNumber(discount.amount, 'currency') %></td>
  </tr>
<% }); %>

<% (rent.debts || []).forEach(function(debt) { %>
  <tr class="item-row">
    <td class="description"><%= debtLabel(debt) %></td>
    <td class="txtAlignRight">1</td>
    <td class="txtAlignRight"><%= _.formatNumber(debt.amount, 'currency') %></td>
    <td class="txtAlignRight"><%= _.formatNumber(debt.amount, 'currency') %></td>
  </tr>
<% }); %>

<% if (!rent._omitCharges) { %>
  <% (rent.charges || []).forEach(function(charge) { %>
    <tr class="item-row">
      <td class="description"><%= _.t('Property charge') %><% if (charge.description) { %>  (<%= charge.description %>)<% } %></td>
      <td class="txtAlignRight">1</td>
      <td class="txtAlignRight"><%= _.formatNumber(charge.amount, 'currency') %></td>
      <td class="txtAlignRight"><%= _.formatNumber(charge.amount, 'currency') %></td>
    </tr>
  <% }); %>
<% } %>

<%
  // rent.charges (Δαπάνη επί του ενοικίου / property surcharge) is
  // intentionally OMITTED from the receipt body — it is paid by the
  // tenant to a third party, not received by the landlord. Rent-calls
  // INCLUDE it so the rendered table sums to the headline grandTotal.
  var chargesCount = !rent._omitCharges ? (rent.charges || []).length : 0;
  var emptyRowCount = Math.max(0, 9 - (rent.preTaxAmounts || []).length - (rent.buildingCharges || []).length - (rent.discounts || []).length - (rent.debts || []).length - chargesCount);
  for (var idx=0; idx<emptyRowCount; idx++) {
%>
  <tr class="item-row">
    <td class="description">&nbsp;</td>
    <td class="txtAlignRight">&nbsp;</td>
    <td class="txtAlignRight">&nbsp;</td>
    <td class="txtAlignRight">&nbsp;</td>
  </tr>
<% } %>
