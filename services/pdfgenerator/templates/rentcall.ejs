<!DOCTYPE html>
<html>
<%- include('partials/htmlhead.ejs') %>

	<body>
		<% tenant.rents.forEach(function(rent) { %>
			<div class="page rentcall">
				<%- include('partials/header.ejs') %>

					<%- include('partials/customeraddress.ejs') %>

						<%- include('partials/customerreference.ejs', { rent: rent }) %>

							<%- include('partials/placeanddate.ejs', {rent: rent}) %>

								<div class="title">
									<%=_.t('Rent call')%>
								</div>

								<div class="limit">
									<%=_.t('The total amount of {{amount}} must be paid before the end of the month.', { amount:
										_.formatNumber(rent.total.grandTotal, 'currency' ) }) %>
								</div>

								<div class="items">
									<table>

										<%- include('partials/invoicebody.ejs', { rent: rent }) %>

											<%- include('partials/rentcalltotal.ejs', { rent: rent }) %>

									</table>
								</div>

								<%- include('partials/paymentmodalities.ejs') %>

									<%- include('partials/footer.ejs') %>
			</div>
			<% }); %>
	</body>

</html>