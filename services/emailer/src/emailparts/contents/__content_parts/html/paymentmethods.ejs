<%# Mirror the PDF partial (pdfgenerator/templates/partials/paymentmodalities.ejs):
    only render a payment method when its data actually exists; when NOTHING is
    configured, render a single "contact the manager/landlord" line instead of
    empty headings. %>
<% var hasBank = landlord.hasBankInfo && landlord.bankInfo.iban;
   var hasCash = landlord.hasContact && (landlord.contacts[0].phone1 || landlord.contacts[0].email);
   var hasCheque = landlord.hasAddress && landlord.addresses[0].street1;
   var hasAny = hasBank || hasCash || hasCheque;
%>
<% if (hasAny) { -%>
<p><%- _.t('Payment modalities:') %></p>
<% if (hasBank) { -%>
<p class="payment-method">
    <u><%- _.t('By bank transfer') %></u><br />
    <%= landlord.bankInfo.name %><br />
    <%- _.t('IBAN: {{iban}}', { iban: landlord.bankInfo.iban }) %>
</p>
<% } -%>
<% if (hasCheque) { -%>
<p class="payment-method">
    <u><%- _.t('By check') %></u><br />
    <%- _.t('Write your check to the order of {{name}} and send it to the following address:', { name: landlord.name }) %><br />
    <%= landlord.name %><br />
    <%= landlord.addresses[0].street1 %><br />
    <%if (landlord.addresses[0].street2) {-%>
        <%= landlord.addresses[0].street2 %><br />
    <%}-%>
    <%= landlord.addresses[0].zipCode %> <%= landlord.addresses[0].city %><br />
    <%if (landlord.addresses[0].state) {-%>
        <%= landlord.addresses[0].state %><br />
    <%}-%>
    <%if (landlord.addresses[0].country) {-%>
        <%= landlord.addresses[0].country %>
    <%}-%>
</p>
<% } -%>
<% if (hasCash) { -%>
<p class="payment-method">
    <u><%- _.t('By cash') %></u><br />
    <% if (landlord.contacts[0].name) { -%><%- _.t('Contact: {{name}}', { name: landlord.contacts[0].name }) %><br /><% } -%>
    <% if (landlord.contacts[0].phone1 || landlord.contacts[0].phone2) { -%><%- _.t('Phone: {{phones}}', { phones: (landlord.contacts[0].phone1 || '') + (landlord.contacts[0].phone2 ? (' / ' + landlord.contacts[0].phone2) : '')}) %><br /><% } -%>
    <% if (landlord.contacts[0].email) { -%><%- _.t('Email: {{email}}', { email: landlord.contacts[0].email }) %><% } -%>
</p>
<% } -%>
<% } else { -%>
<p><%- _.t('Please contact the property manager or landlord regarding rent payment.') %></p>
<% } -%>

<p>
    <%- _.t('If you have already paid this amount, we thank you and invite you to ignore this message.') %>
</p>
