mre-*
mre
mre.exe
mre-macos


# Working files for NAS deployment debug
.tmp/

# NAS deployment — kept local, pasted into Portainer
docker-compose.nas.yml

# Deploy script secrets (GitHub PAT, Portainer token)
.secrets/
# e2e symlink that points at the repo-root .secrets/ — never track it
e2e-playwright/.secrets
# Scratch / diagnostic specs (underscore-prefixed, not part of the suite)
e2e-playwright/tests/_*.spec.ts
# TS incremental build cache
*.tsbuildinfo

# Local VS Code multi-root workspace file
*.code-workspace

# macOS Finder metadata
.DS_Store

# Local agent tooling / session artifacts
.claude/
.impeccable/

# Adversarial Step-7 workflow scratch test files (subagents leave these in __tests__)
**/__tests__/*probe*.test.js
**/__tests__/*skeptic*.test.js
**/__tests__/_diag*.test.js
**/__tests__/ZZ_*.test.js
**/__tests__/zz_*.test.js

# Playwright run artifacts (traces/screenshots/videos + last-run state). These
# are regenerated on every run and were never meant to be tracked.
test-results/
playwright-report/
e2e-playwright/test-results/
e2e-playwright/playwright-report/

# Scratch working directory for adversarial reviews and bill-parser sampling.
# CONTAINS REAL CUSTOMER DATA (OCR'd utility bills: names, ΑΦΜ, provision
# numbers, addresses) — this repo is PUBLIC. Never commit it.
.scratch-adv-tests/

# Ad-hoc probe/verification specs written during a session (see the
# __tests__ patterns above for the jest equivalents).
e2e-playwright/tests/_probe*.spec.ts
e2e-playwright/tests/_verify_*.spec.ts
e2e-playwright/_postdeploy/
