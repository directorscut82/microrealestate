# Working files for NAS deployment debug
.tmp/

# NAS deployment — kept local, pasted into Portainer
docker-compose.nas.yml

# Deploy script secrets (GitHub PAT, Portainer token)
.secrets/
# e2e symlink that points at the repo-root .secrets/ — never track it
e2e-playwright/.secrets
# Scratch / diagnostic specs (underscore-prefixed, not part of the suite)
e2e-playwright/tests/_*.spec.ts
# TS incremental build cache
*.tsbuildinfo

# Local VS Code multi-root workspace file
*.code-workspace

# macOS Finder metadata
.DS_Store

# Local agent tooling / session artifacts
.claude/
.impeccable/

# Adversarial Step-7 workflow scratch test files (subagents leave these in __tests__)
**/__tests__/*probe*.test.js
**/__tests__/*skeptic*.test.js
**/__tests__/_diag*.test.js
**/__tests__/ZZ_*.test.js
**/__tests__/zz_*.test.js

# Playwright run artifacts (traces/screenshots/videos + last-run state). These
# are regenerated on every run and were never meant to be tracked.
test-results/
playwright-report/
e2e-playwright/test-results/
e2e-playwright/playwright-report/

# Scratch working directory for adversarial reviews and bill-parser sampling.
# CONTAINS REAL CUSTOMER DATA (OCR'd utility bills: names, ΑΦΜ, provision
# numbers, addresses) — this repo is PUBLIC. Never commit it.
.scratch-adv-tests/

# Ad-hoc probe/verification specs written during a session (see the
# __tests__ patterns above for the jest equivalents). These drive the LIVE
# production realm and routinely quote real owner names, ΑΦΜ, ATAK numbers and
# absolute paths to real AADE PDFs on the author's laptop — they are scratch,
# never suite, and must not be published.
# NOTE: the pattern is `_verify*`, not `_verify_*`. The underscore-suffixed
# form did NOT match `_verifyT0_e9_dialog.spec.ts` / `_verifyT2_...`, which is
# how two specs carrying real family names + tax ids stayed tracked on public
# branches. Ignore the shape, not the names that already caused a problem.
e2e-playwright/tests/_probe*.spec.ts
e2e-playwright/tests/_verify*.spec.ts

# Every underscore-prefixed scratch directory under e2e-playwright/. These hold
# session artifacts from driving the LIVE production realm: screenshots of real
# tenants/owners, findings write-ups quoting real names and amounts, DOM dumps.
# 18 such directories and 151 screenshots existed untracked-but-unignored, i.e.
# one `git add -A` away from being published. Ignore the shape, not each name —
# the previous per-directory rules only ever covered the ones that had already
# caused a problem.
e2e-playwright/_*/

# Design mockups are hand-built from screenshots of the live realm and quote real
# owner names, addresses and balances as sample data. Keep them local.
documentation/mockups/

# Python bytecode from the seed scripts. Machine-generated, and a .pyc embeds
# string literals from its source — including anything read from .secrets/.
__pycache__/
*.pyc

# Ad-hoc driver scripts at the e2e root (same rationale as tests/_*.spec.ts:
# throwaway probes that hardcode realm data while debugging a live surface).
e2e-playwright/_*.mjs

# Audit spec hand-off files for implementation agents (never commit — they quote live data)
.audit-specs/

# Throwaway root-level probe scripts (.ct/.mg2/.zt style): one-off node snippets used
# to exercise a real decrypt / Mongoose schema / zod schema while debugging a live
# surface. Same rationale as e2e-playwright/_*.mjs — they hardcode realm data.
/.[a-z]*.cjs
